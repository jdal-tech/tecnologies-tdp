---
// src/components/SimuladorToDo.astro
---
<div class="js-widget not-content">
  <div class="widget-header">
    <span class="badge">Laboratori interactiu</span>
    <h4>Com construir una llista dinàmica: <code>=</code> vs <code>+=</code></h4>
    <p class="guide">
      1. Afegeix 2 o 3 tasques a la llista. 2. Prova de canviar entre l'operador <code>+=</code> (acumular) i <code>=</code> (substituir) per entendre per què desapareixen els elements anteriors si t'oblides del <code>+</code>.
    </p>
  </div>

  <div class="todo-controls">
    <div class="mode-switch">
      <button type="button" class="op-btn active" data-op="+=">
        Mode correcte: <code>llista.innerHTML += ...</code>
      </button>
      <button type="button" class="op-btn" data-op="=">
        Error típic: <code>llista.innerHTML = ...</code>
      </button>
    </div>

    <div class="add-row">
      <input type="text" id="task-input" placeholder="Ex: Estudiar JavaScript" value="Repassar selectors DOM" />
      <button type="button" id="btn-add-task">Afegir tasca</button>
      <button type="button" id="btn-clear-tasks" class="btn-sec">Buidar</button>
    </div>
  </div>

  <div class="todo-stage">
    <!-- ESQUERRA: LLISTA VISUAL -->
    <div class="stage-box">
      <div class="box-title">1. Llista a la web (<code>&lt;ul id="llista"&gt;</code>)</div>
      <ul id="visual-ul" class="visual-list">
        <li>Preparar l'entorn VS Code</li>
      </ul>
    </div>

    <!-- DRETA: HTML GENERAT INTERNAMENT -->
    <div class="stage-box">
      <div class="box-title">2. Codi HTML que hi ha dins de <code>&lt;ul&gt;</code></div>
      <pre class="dom-tree"><code id="raw-ul-code">&lt;ul id="llista"&gt;
  &lt;li&gt;Preparar l'entorn VS Code&lt;/li&gt;
&lt;/ul&gt;</code></pre>
    </div>
  </div>

  <div class="exec-line">
    <span>Instrucció executada:</span>
    <code id="todo-js-line">llista.innerHTML += `&lt;li&gt;Repassar selectors DOM&lt;/li&gt;`;</code>
  </div>
</div>

<script>
  const taskInput = document.getElementById('task-input') as HTMLInputElement;
  const btnAdd = document.getElementById('btn-add-task')!;
  const btnClear = document.getElementById('btn-clear-tasks')!;
  const opBtns = document.querySelectorAll('.op-btn');

  const visualUl = document.getElementById('visual-ul')!;
  const rawUlCode = document.getElementById('raw-ul-code')!;
  const todoJsLine = document.getElementById('todo-js-line')!;

  let operator = '+=';
  let items: string[] = ["Preparar l'entorn VS Code"];

  function updateView() {
    visualUl.innerHTML = items.map(t => `<li>${t}</li>`).join('');
    if (items.length === 0) {
      rawUlCode.textContent = '<ul id="llista">\n  <!-- Llista buida -->\n</ul>';
    } else {
      const inner = items.map(t => `  <li>${t}</li>`).join('\n');
      rawUlCode.textContent = `<ul id="llista">\n${inner}\n</ul>`;
    }
  }

  opBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      opBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      operator = (btn as HTMLElement).dataset.op!;
      const sample = taskInput.value.trim() || 'Nova tasca';
      todoJsLine.textContent = `llista.innerHTML ${operator} \`<li>${sample}</li>\`;`;
    });
  });

  btnAdd.addEventListener('click', () => {
    const text = taskInput.value.trim();
    if (!text) return;

    // Escapem caràcters bàsics per seguretat visual a la demo
    const safeText = text.replace(/</g, '&lt;').replace(/>/g, '&gt;');

    if (operator === '+=') {
      items.push(safeText);
    } else {
      items = [safeText];
    }

    todoJsLine.textContent = `llista.innerHTML ${operator} \`<li>${text}</li>\`;`;
    taskInput.value = '';
    updateView();
  });

  btnClear.addEventListener('click', () => {
    items = [];
    todoJsLine.textContent = 'llista.innerHTML = ""; // Buidar tota la llista';
    updateView();
  });
</script>

<style>
  .js-widget,
  .js-widget * {
    box-sizing: border-box;
  }
  .js-widget {
    margin: 1.5rem 0;
    padding: 1.5rem;
    border-radius: 12px;
    background: #0f172a;
    border: 1px solid rgba(148, 163, 184, 0.25);
    max-width: 100%;
    overflow: hidden;
  }
  .widget-header { margin-bottom: 1.25rem; }
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #facc15;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .widget-header h4 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    color: #f8fafc;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .widget-header code {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    border: 1px solid rgba(56, 189, 248, 0.35);
    font-size: 1.05rem;
  }
  .guide { margin: 0; font-size: 0.92rem; line-height: 1.5; color: #cbd5e1; }
  .guide code {
    background: rgba(15, 23, 42, 0.7);
    color: #facc15;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-size: 0.85rem;
  }

  .todo-controls {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .mode-switch {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.5rem;
  }
  @media (max-width: 680px) {
    .mode-switch { grid-template-columns: minmax(0, 1fr); }
  }
  .op-btn {
    padding: 0.55rem 0.8rem;
    border-radius: 8px;
    background: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    font-size: 0.85rem;
    cursor: pointer;
    text-align: center;
  }
  .op-btn code { background: transparent; color: inherit; font-family: monospace; }
  .op-btn.active[data-op="+="] {
    background: rgba(34, 197, 94, 0.15);
    border-color: #22c55e;
    color: #f8fafc;
    font-weight: 700;
  }
  .op-btn.active[data-op="="] {
    background: rgba(239, 68, 68, 0.15);
    border-color: #ef4444;
    color: #f8fafc;
    font-weight: 700;
  }

  .add-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  input[type="text"] {
    flex: 1;
    min-width: 180px;
    height: 40px;
    padding: 0 0.75rem;
    border-radius: 8px;
    background: #1e293b;
    color: #f8fafc;
    border: 1px solid #475569;
    font-size: 0.92rem;
  }
  #btn-add-task {
    height: 40px;
    padding: 0 1rem;
    border-radius: 8px;
    background: #38bdf8;
    color: #082f49;
    border: none;
    font-weight: 700;
    cursor: pointer;
  }
  .btn-sec {
    height: 40px;
    padding: 0 0.85rem;
    border-radius: 8px;
    background: #1e293b;
    color: #cbd5e1;
    border: 1px solid #475569;
    cursor: pointer;
  }

  .todo-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 1rem;
    margin-bottom: 1rem;
  }
  @media (max-width: 720px) {
    .todo-stage { grid-template-columns: minmax(0, 1fr); }
  }
  .stage-box {
    min-width: 0;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .box-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: #38bdf8;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.4rem;
  }
  .box-title code { background: transparent; color: #facc15; }
  .visual-list {
    margin: 0;
    padding-left: 1.25rem;
    color: #f8fafc;
    font-size: 0.92rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .dom-tree {
    margin: 0;
    padding: 0.75rem;
    background: #020617;
    border-radius: 8px;
    font-family: monospace;
    font-size: 0.82rem;
    line-height: 1.5;
    color: #94a3b8;
    overflow-x: auto;
  }

  .exec-line {
    background: #020617;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  .exec-line span { color: #94a3b8; font-weight: 600; }
  .exec-line code { color: #4ade80; font-family: monospace; word-break: break-all; }
</style>