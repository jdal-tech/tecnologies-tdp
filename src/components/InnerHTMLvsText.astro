---
// src/components/InnerHTMLvsText.astro
---
<div class="js-widget not-content">
  <div class="widget-header">
    <span class="badge">Laboratori interactiu</span>
    <h4><code>.textContent</code> vs <code>.innerHTML</code></h4>
    <p class="guide">
      Escriu text amb etiquetes HTML (o prem els exemples ràpids) i compara com interpreta la mateixa cadena cada propietat.
    </p>
  </div>

  <div class="input-section">
    <label for="html-raw-input">Cadena de text a injectar:</label>
    <input
      type="text"
      id="html-raw-input"
      value="Hola <strong>1r Batxillerat</strong>, això és <em>HTML real</em>!"
    />
    <div class="presets">
      <button type="button" class="preset-btn" data-val="Text normal sense etiquetes">Text normal</button>
      <button type="button" class="preset-btn" data-val="Hola <strong>1r Batxillerat</strong>, això és <em>HTML real</em>!">Negreta i cursiva</button>
      <button type="button" class="preset-btn" data-val="<li>Element de llista</li>">Etiqueta &lt;li&gt;</button>
    </div>
  </div>

  <div class="compare-grid">
    <!-- COLUMNA ESQUERRA: textContent -->
    <div class="comp-card">
      <div class="comp-head">
        <code>caixa.textContent = text;</code>
        <span class="pill-safe">Text literal</span>
      </div>
      <div id="out-textcontent" class="render-box"></div>
      <p class="comp-note">El navegador ho tracta com a caràcters normals i ensenya les etiquetes escrites.</p>
    </div>

    <!-- COLUMNA DRETA: innerHTML -->
    <div class="comp-card">
      <div class="comp-head">
        <code>caixa.innerHTML = text;</code>
        <span class="pill-html">Interpreta etiquetes</span>
      </div>
      <div id="out-innerhtml" class="render-box"></div>
      <p class="comp-note">El navegador llegeix les etiquetes i crea nous nodes al DOM.</p>
    </div>
  </div>
</div>

<script>
  const rawInput = document.getElementById('html-raw-input') as HTMLInputElement;
  const outText = document.getElementById('out-textcontent')!;
  const outHtml = document.getElementById('out-innerhtml')!;
  const presetBtns = document.querySelectorAll('.preset-btn');

  function syncOutputs() {
    const val = rawInput.value;
    outText.textContent = val;
    outHtml.innerHTML = val;
  }

  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      rawInput.value = (btn as HTMLElement).dataset.val!;
      syncOutputs();
    });
  });

  rawInput.addEventListener('input', syncOutputs);
  syncOutputs();
</script>

<style>
  .js-widget,
  .js-widget * {
    box-sizing: border-box;
  }
  .js-widget {
    margin: 1.5rem 0;
    padding: 1.5rem;
    border-radius: 12px;
    background: #0f172a;
    border: 1px solid rgba(148, 163, 184, 0.25);
    max-width: 100%;
    overflow: hidden;
  }
  .widget-header { margin-bottom: 1.25rem; }
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #facc15;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .widget-header h4 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    color: #f8fafc;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .widget-header code {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    border: 1px solid rgba(56, 189, 248, 0.35);
    font-size: 1.05rem;
  }
  .guide { margin: 0; font-size: 0.92rem; line-height: 1.5; color: #cbd5e1; }

  .input-section {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 1rem;
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  label { font-size: 0.85rem; font-weight: 600; color: #94a3b8; }
  input[type="text"] {
    width: 100%;
    height: 40px;
    padding: 0 0.75rem;
    border-radius: 8px;
    background: #0f172a;
    color: #f8fafc;
    border: 1px solid #475569;
    font-family: monospace;
    font-size: 0.92rem;
  }
  .presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .preset-btn {
    padding: 0.35rem 0.7rem;
    border-radius: 6px;
    background: #0f172a;
    color: #cbd5e1;
    border: 1px solid #475569;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .preset-btn:hover { border-color: #38bdf8; color: #f8fafc; }

  .compare-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
  }
  @media (max-width: 720px) {
    .compare-grid { grid-template-columns: minmax(0, 1fr); }
  }
  .comp-card {
    min-width: 0;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .comp-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .comp-head code {
    font-family: monospace;
    font-size: 0.85rem;
    color: #f8fafc;
    background: #0f172a;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
  }
  .pill-safe, .pill-html {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }
  .pill-safe { background: rgba(148, 163, 184, 0.2); color: #cbd5e1; }
  .pill-html { background: rgba(34, 197, 94, 0.2); color: #4ade80; }

  .render-box {
    min-height: 58px;
    padding: 0.85rem;
    border-radius: 8px;
    background: #0f172a;
    border: 1px dashed #475569;
    color: #f8fafc;
    font-size: 0.95rem;
    word-break: break-word;
  }
  .comp-note {
    margin: 0;
    font-size: 0.84rem;
    color: #94a3b8;
  }
</style>