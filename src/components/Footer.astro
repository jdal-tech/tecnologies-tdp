---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default {...Astro.props}><slot /></Default>

<footer class="portal-footer">
  <div class="footer-content">
    
    <!-- Part esquerra: Departament i Institut -->
    <div class="footer-left">
      <span class="footer-logo">&lt;/&gt; Dept. de Tecnologies</span>
      <span class="footer-sub">Institut Torre del Palau · Terrassa</span>
    </div>

    <!-- Part dreta: Autoria i Llicència CC BY-NC-SA -->
    <div class="footer-right">
      <a 
        href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.ca" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="cc-badge"
        title="Llicència Creative Commons BY-NC-SA 4.0"
      >
        <svg width="88" height="31" viewBox="0 0 88 31" xmlns="http://www.w3.org/2000/svg">
          <rect width="88" height="31" rx="4" fill="#1e293b" stroke="#475569" stroke-width="1"/>
          <circle cx="15" cy="15.5" r="9.5" fill="none" stroke="#f8fafc" stroke-width="1.8"/>
          <text x="15" y="18.5" text-anchor="middle" fill="#f8fafc" font-family="sans-serif" font-weight="bold" font-size="8.5">CC</text>
          <text x="54" y="13.5" text-anchor="middle" fill="#f8fafc" font-family="sans-serif" font-weight="bold" font-size="8.5">BY · NC · SA</text>
          <text x="54" y="23.5" text-anchor="middle" fill="#94a3b8" font-family="sans-serif" font-size="7">4.0 Internacional</text>
        </svg>
      </a>

      <div class="license-text">
        <div>
          Portal creat per <strong>J.Dalmau</strong> amb assistència de la IA
        </div>
        <div>
          Codi: <a href="/license/">AGPLv3</a> · Continguts: <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.ca" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a> · © {new Date().getFullYear()}
        </div>
      </div>
    </div>

  </div>
</footer>

<style>
  .portal-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(148, 163, 184, 0.2);
    font-size: 0.82rem;
    color: #94a3b8;
  }
  :root[data-theme='light'] .portal-footer {
    color: #475569;
    border-top-color: #e2e8f0;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  /* Esquerra */
  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .footer-logo {
    font-family: monospace;
    font-weight: 700;
    font-size: 0.9rem;
    color: #38bdf8;
  }
  :root[data-theme='light'] .footer-logo {
    color: #0082C1;
  }
  .footer-sub {
    font-size: 0.78rem;
  }

  /* Dreta (estil captura) */
  .footer-right {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .cc-badge {
    display: inline-flex;
    line-height: 0;
    transition: opacity 0.2s ease;
  }
  .cc-badge:hover {
    opacity: 0.85;
  }

  .license-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    line-height: 1.35;
  }
  .license-text strong {
    color: #e2e8f0;
    font-weight: 700;
  }
  :root[data-theme='light'] .license-text strong {
    color: #0f172a;
  }
  .license-text a {
    color: #e2e8f0;
    font-weight: 700;
    text-decoration: none;
  }
  :root[data-theme='light'] .license-text a {
    color: #0f172a;
  }
  .license-text a:hover {
    color: #38bdf8;
    text-decoration: underline;
  }
  :root[data-theme='light'] .license-text a:hover {
    color: #0082C1;
  }
</style>